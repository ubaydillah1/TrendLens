# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Python AI Backend (py-be)
PY_BE_PORT=8001
PY_BE_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/trendlens_ai
GEMINI_API_KEY=your_gemini_api_key_here

# Golang Core Backend (go-be)
GO_BE_PORT=8080
GO_BE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/trendlens_core?sslmode=disable
